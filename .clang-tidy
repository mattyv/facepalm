# Google's C++ Style Guide and general correctness checks. Any finding fails
# the build when FACEPALM_TIDY is on.
#
# Turned off, and followed by hand where they matter:
#   modernize-use-trailing-return-type: Google writes leading return types.
#   readability-identifier-length: Google allows a short name in a small scope.
#   misc-include-cleaner: reports libc++'s internal headers on macOS.
#   readability-trailing-comma: not in Google's guide, and it fights clang-format.
Checks: >
  bugprone-*,
  google-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -misc-include-cleaner,
  -readability-trailing-comma
HeaderFilterRegex: '(src|test)/.*'
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
